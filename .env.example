PORT=5000
# Use localhost for `npm start`; Docker Compose overrides this to the `mysql` service.
DB_HOST=localhost
DB_PORT=3306
# Used by the MySQL container and the one-time `db-init` service to create/grant
# the restricted runtime account. It is also the root fallback for a direct
# local `npm start` only when DB_APP_USER/DB_APP_PASSWORD are not configured.
# The Docker application container does not receive this value.
DB_USER=root
DB_PASSWORD=replace_with_a_strong_local_mysql_password
DB_NAME=todo_app

# Restricted database identity used by the Taskolab application at runtime.
# Generate DB_APP_PASSWORD with base64url characters (A-Z, a-z, 0-9, _ and -).
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DB_APP_USER=taskolab_app
DB_APP_PASSWORD=replace_with_a_unique_base64url_application_password

# Authentication settings. Generate a unique value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the generated value.
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h

# The exact browser origin permitted to call the API from another origin.
APP_ORIGIN=http://localhost:5000
